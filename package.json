{
  "name": "assetidprotocol",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply asset-registry --local",
    "db:remote": "wrangler d1 migrations apply asset-registry --remote",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "typescript": "5.9.3",
    "wrangler": "4.86.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  },
  "engines": {
    "node": ">=20"
  }
}
